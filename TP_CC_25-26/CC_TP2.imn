node n1 {
    type router
    model host
    network-config {
	hostname n1
	!
	interface eth2
	 ip address 10.0.4.10/24
	 ipv6 address 2001:4::10/64
	!
	interface eth3
	 ip address 10.0.6.10/24
	 ipv6 address 2001:6::10/64
	!
	interface eth1
	 ip address 10.0.2.10/24
	 ipv6 address 2001:2::10/64
	!
	interface eth0
	 ip address 10.0.1.10/24
	 ipv6 address 2001:1::10/64
	!
    }
    canvas c1
    iconcoords {518.0 180.0}
    labelcoords {518.0 212.0}
    interface-peer {eth0 n5}
    interface-peer {eth1 n4}
    interface-peer {eth3 n8}
    interface-peer {eth2 n13}
    services {OSPFv2 zebra DefaultRoute SSH}
}

