link l1 {
    nodes {n7 n5}
    bandwidth 0
}

link l2 {
    delay 25000
    ber 6
    nodes {n5 n1}
    bandwidth 0
}

link l3 {
    delay 25000
    ber 5
    nodes {n1 n4}
    bandwidth 0
}

link l4 {
    nodes {n4 n6}
    bandwidth 0
}

link l7 {
    ber 10
    nodes {n8 n1}
    bandwidth 0
}

link l9 {
    nodes {n4 n10}
    bandwidth 0
}

link l10 {
    nodes {n4 n11}
    bandwidth 0
}

link l11 {
    nodes {n5 n12}
    bandwidth 0
}

link l5 {
    delay 20000
    ber 5
    nodes {n1 n13}
    bandwidth 0
}

link l6 {
    delay 10000
    ber 2
    nodes {n13 n2}
    bandwidth 0
}

link l8 {
    nodes {n2 n3}
    bandwidth 0
}

link l12 {
    nodes {n2 n9}
    bandwidth 0
}

link l13 {
    nodes {n13 n14}
    bandwidth 0
}

canvas c1 {
    name {Canvas1}
}

option global {
    interface_names no
    ip_addresses yes
    ipv6_addresses yes
    node_labels yes
    link_labels yes
    show_api no
    background_images no
    annotations yes
    grid yes
    traffic_start 0
}

option session {
}

